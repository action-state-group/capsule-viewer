{
  "name": "@action-state-group/capsule-viewer",
  "version": "0.8.0",
  "description": "capsule-viewer page emitter and presentation builder, under the Agent Action Capsule presentation contract",
  "license": "Apache-2.0 AND BSD-3-Clause",
  "type": "module",
  "files": [
    "dist",
    "vendor",
    "README.md",
    "LICENSE",
    "LICENSE-BSD-3-Clause"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/emitter-shell.html dist/emitter-shell.html && npm run emitter:iife",
    "prepare": "npm run build",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build && npm run check:package",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:package": "node scripts/check-package.mjs",
    "emitter:iife": "node scripts/build-iife.mjs"
  },
  "dependencies": {
    "@action-state-group/agent-action-capsule": "0.13.0",
    "@action-state-group/cll": "0.3.0"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.2",
    "ajv": "8.17.1",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "playwright-core": "1.64.0",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vega-lite": "5.23.0",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/action-state-group/capsule-viewer.git",
    "directory": "ts"
  },
  "publishConfig": {
    "access": "public"
  }
}
