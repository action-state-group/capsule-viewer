{
  "_comment": "The one source of every design token. Edit here, then run `python3 scripts/gen-tokens.py`; `--check` (run by tests/test_tokens_sync.py) fails when a generated file differs. A shell value \"@name\" is that palette colour.",
  "palette": {
    "navy": "#232f42",
    "gold": "#e8a33d",
    "gold-l": "#fbefd9",
    "cream": "#f6f2ea",
    "line": "#e3ded3",
    "slate": "#6b7482",
    "ink": "#1f2733",
    "ok": "#2e7d5b",
    "ok-l": "#e3f1ea",
    "bad": "#b5462f",
    "bad-l": "#f8e6e1",
    "person": "#5b4ba0",
    "person-l": "#ece8f7"
  },
  "shell": {
    "bg": "#ffffff",
    "fg": "@ink",
    "muted": "@slate",
    "line": "@line",
    "accent": "@navy",
    "focus": "#2b5a85",
    "ok": "@ok",
    "ok-bg": "@ok-l",
    "bad": "@bad",
    "bad-bg": "@bad-l",
    "warn": "#8a6a2f",
    "warn-bg": "@gold-l",
    "font": "system-ui, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
    "line-height": "1.5",
    "page-width": "60rem",
    "gutter": "1rem",
    "page-pad-block": "1.5rem 2.5rem",
    "radius": "10px",
    "page-bg": "#eef0f3",
    "inset": "clamp(20px, 5vw, 56px)"
  },
  "frames": {
    "cc": {
      "palette": [
        "navy",
        "gold-l",
        "cream",
        "line",
        "slate",
        "ink",
        "ok",
        "ok-l",
        "bad",
        "bad-l",
        "person",
        "person-l"
      ],
      "radius": "14px"
    },
    "oi": {
      "palette": [
        "navy",
        "gold",
        "gold-l",
        "cream",
        "line",
        "slate",
        "ink",
        "ok",
        "ok-l",
        "bad",
        "bad-l",
        "person",
        "person-l"
      ],
      "radius": "14px"
    }
  },
  "kit": {
    "font-sans": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
    "font-mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace",
    "font-size-sm": "0.8125rem",
    "font-size-md": "0.9375rem",
    "font-size-lg": "1.125rem",
    "line-height": "1.5",
    "space-1": "0.25rem",
    "space-2": "0.5rem",
    "space-3": "0.75rem",
    "space-4": "1rem",
    "space-5": "1.5rem",
    "radius": "0.5rem",
    "radius-pill": "999px",
    "color-text": "#1b1f27",
    "color-text-muted": "#4d5564",
    "color-surface": "#ffffff",
    "color-surface-sunken": "#f4f5f7",
    "color-border": "#d3d7de",
    "color-accent": "#2445a8",
    "color-positive-fg": "#17603a",
    "color-positive-bg": "#e6f3eb",
    "color-negative-fg": "#a31d1d",
    "color-negative-bg": "#fbe9e9",
    "color-caution-fg": "#6f4700",
    "color-caution-bg": "#fcf1dc",
    "color-neutral-fg": "#3d4452",
    "color-neutral-bg": "#eceef2",
    "color-info-fg": "#1f3c94",
    "color-info-bg": "#e7ecfb"
  }
}
